
pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Select the Terraform environment'
        )
        choice(
            name: 'ACTION',
            choices: ['PLAN', 'APPLY', 'DESTROY'],
            description: 'Select Terraform action'
        )
    }

    environment {
        AWS_REGION       = 'us-east-1'
        AWS_CRED         = 'AWS'
        TF_IN_AUTOMATION = 'true'
        TF_INPUT         = 'false'
    }

    stages {
        stage('Validate Parameters') {
            steps {
                script {
                    if (!params.ENVIRONMENT?.trim()) {
                        error('ENVIRONMENT must be selected.')
                    }

                    if (!params.ACTION?.trim()) {
                        error('ACTION must be selected.')
                    }

                    env.TF_ENVIRONMENT = params.ENVIRONMENT
                    env.TF_ACTION = params.ACTION
                }

                echo "Selected Environment: ${params.ENVIRONMENT}"
                echo "Selected Action: ${params.ACTION}"
            }
        }

        stage('Verify AWS Access') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CRED}"]
                ]) {
                    sh '''
                        set -e
                        set +x

                        export AWS_DEFAULT_REGION="$AWS_REGION"

                        echo "=========================================="
                        echo "Verifying AWS Identity"
                        echo "=========================================="

                        aws sts get-caller-identity

                        echo "AWS authentication successful"
                        echo "=========================================="
                    '''
                }
            }
        }

        stage('Terraform Init') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CRED}"]
                ]) {
                    sh '''
                        set -e
                        set +x

                        export AWS_DEFAULT_REGION="$AWS_REGION"

                        BACKEND_CONFIG="backend_conf/backend_${TF_ENVIRONMENT}.conf"
                        TFVARS_FILE="env/${TF_ENVIRONMENT}.tfvars"

                        echo "=========================================="
                        echo "Terraform Environment : ${TF_ENVIRONMENT}"
                        echo "Terraform Action      : ${TF_ACTION}"
                        echo "Terraform Backend     : ${BACKEND_CONFIG}"
                        echo "Terraform Variables   : ${TFVARS_FILE}"
                        echo "=========================================="

                        echo "Checking backend configuration..."

                        if [ ! -f "$BACKEND_CONFIG" ]; then
                            echo "ERROR: Backend configuration not found: $BACKEND_CONFIG"
                            echo "Current directory: $(pwd)"
                            echo "Available backend files:"
                            ls -la backend_conf/ || true
                            exit 1
                        fi

                        echo "Checking Terraform variables file..."

                        if [ ! -f "$TFVARS_FILE" ]; then
                            echo "ERROR: Terraform variable file not found: $TFVARS_FILE"
                            echo "Available variable files:"
                            ls -la env/ || true
                            exit 1
                        fi

                        echo "Initializing Terraform backend..."

                        terraform init \
                            -input=false \
                            -reconfigure \
                            -backend-config="$BACKEND_CONFIG"

                        echo "Terraform backend initialized successfully"
                        echo "=========================================="
                    '''
                }
            }
        }

        stage('Terraform Format') {
            steps {
                sh '''
                    set -e

                    echo "Checking Terraform formatting..."

                    terraform fmt -check -recursive

                    echo "Terraform formatting check passed"
                '''
            }
        }

        stage('Terraform Validate') {
            steps {
                sh '''
                    set -e

                    echo "Validating Terraform configuration..."

                    terraform validate

                    echo "Terraform validation completed successfully"
                '''
            }
        }

        stage('Terraform Plan') {
            when {
                expression {
                    return params.ACTION == 'PLAN' || params.ACTION == 'APPLY'
                }
            }
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CRED}"]
                ]) {
                    sh '''
                        set -e
                        set +x

                        export AWS_DEFAULT_REGION="$AWS_REGION"

                        TFVARS_FILE="env/${TF_ENVIRONMENT}.tfvars"

                        echo "Creating Terraform execution plan..."

                        terraform plan \
                            -input=false \
                            -var-file="$TFVARS_FILE" \
                            -out="tfplan-${TF_ENVIRONMENT}"

                        echo "=========================================="
                        echo "Terraform plan completed successfully"
                        echo "Environment: ${TF_ENVIRONMENT}"
                        echo "=========================================="
                    '''
                }
            }
        }

        stage('Manual Approval - Apply') {
            when {
                expression {
                    return params.ACTION == 'APPLY'
                }
            }
            steps {
                input(
                    message: "Approve Terraform APPLY for ${params.ENVIRONMENT}?",
                    ok: 'Approve Apply'
                )
            }
        }

        stage('Terraform Apply') {
            when {
                expression {
                    return params.ACTION == 'APPLY'
                }
            }
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CRED}"]
                ]) {
                    sh '''
                        set -e
                        set +x

                        export AWS_DEFAULT_REGION="$AWS_REGION"

                        echo "Applying Terraform execution plan..."

                        terraform apply \
                            -input=false \
                            -auto-approve \
                            "tfplan-${TF_ENVIRONMENT}"

                        echo "=========================================="
                        echo "Terraform apply completed successfully"
                        echo "Environment: ${TF_ENVIRONMENT}"
                        echo "=========================================="
                    '''
                }
            }
        }

        stage('Terraform Destroy Plan') {
            when {
                expression {
                    return params.ACTION == 'DESTROY'
                }
            }
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CRED}"]
                ]) {
                    sh '''
                        set -e
                        set +x

                        export AWS_DEFAULT_REGION="$AWS_REGION"

                        TFVARS_FILE="env/${TF_ENVIRONMENT}.tfvars"

                        echo "=========================================="
                        echo "WARNING: Terraform DESTROY PLAN"
                        echo "Environment: ${TF_ENVIRONMENT}"
                        echo "=========================================="

                        terraform plan \
                            -destroy \
                            -input=false \
                            -var-file="$TFVARS_FILE" \
                            -out="destroy-${TF_ENVIRONMENT}"

                        echo "=========================================="
                        echo "Terraform destroy plan completed"
                        echo "Environment: ${TF_ENVIRONMENT}"
                        echo "=========================================="
                    '''
                }
            }
        }

        stage('Manual Approval - Destroy') {
            when {
                expression {
                    return params.ACTION == 'DESTROY'
                }
            }
            steps {
                input(
                    message: "WARNING: Approve Terraform DESTROY for ${params.ENVIRONMENT}?",
                    ok: 'Approve Destroy'
                )
            }
        }

        stage('Terraform Destroy') {
            when {
                expression {
                    return params.ACTION == 'DESTROY'
                }
            }
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CRED}"]
                ]) {
                    sh '''
                        set -e
                        set +x

                        export AWS_DEFAULT_REGION="$AWS_REGION"

                        echo "Executing Terraform destroy plan..."

                        terraform apply \
                            -input=false \
                            -auto-approve \
                            "destroy-${TF_ENVIRONMENT}"

                        echo "=========================================="
                        echo "Terraform destroy completed successfully"
                        echo "Environment: ${TF_ENVIRONMENT}"
                        echo "=========================================="
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Terraform ${params.ACTION} for ${params.ENVIRONMENT} completed successfully."
        }

        failure {
            echo "Terraform ${params.ACTION} for ${params.ENVIRONMENT} failed."
        }

        always {
            echo "Terraform environment: ${params.ENVIRONMENT}"

            script {
                if (params.ENVIRONMENT) {
                    sh """
                        rm -f "tfplan-${params.ENVIRONMENT}" 2>/dev/null || true
                        rm -f "destroy-${params.ENVIRONMENT}" 2>/dev/null || true
                    """
                }
            }
        }
    }
}
